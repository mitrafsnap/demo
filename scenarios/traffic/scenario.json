  "versions": {
    "v1": {
      "detector": {
        "asset": "yolox_tiny",
        "file": "detector.onnx",
        "kind": "yolox",
        "input": 416,
        "classes": [
          "person",
          "car"
        ],
        "enabled": true,
        "label": "YOLOX-Tiny: people, cars"
      },
      "segmenter": {
        "placeholder": true,
        "file": "segmenter.onnx",
        "decoder_file": "segmenter-decoder.onnx",
        "kind": "boxsam",
        "classes": [
          "person",
          "bicycle",
          "car",
          "motorcycle",
          "bus",
          "truck",
          "train"
        ],
        "label": "segmenter: not shipped yet"
      },
      "classifier": {
        "asset": "resnet152",
        "file": "classifier.onnx",
        "kind": "imagenet-cls",
        "label": "ResNet-152 classifier (unused by this camera)"
      },
      "aux": {
        "asset": "vgg16",
        "file": "aux.onnx",
        "kind": "imagenet-cls",
        "label": "VGG-16 classifier (unused by this camera)"
      }
    },
    "v2": {
      "segmenter": {
        "asset": "mobilesam_encoder",
        "file": "segmenter.onnx",
        "decoder_asset": "mobilesam_decoder",
        "decoder_file": "segmenter-decoder.onnx",
        "kind": "boxsam",
        "classes": [
          "person",
          "bicycle",
          "car",
          "motorcycle",
          "bus",
          "truck",
          "train"
        ],
        "enabled": true,
        "label": "MobileSAM instance masks for detected objects"
      }
    },
    "v3": {
      "detector": {
        "asset": "yolox_s",
        "file": "detector.onnx",
        "kind": "yolox",
        "input": 640,
        "classes": [
          "person",
          "bicycle",
          "car",
          "motorcycle",
          "bus",
          "truck",
          "train"
        ],
        "enabled": true,
        "label": "YOLOX-S: + bicycles, motorcycles, buses, trucks"
      }
    },
    "v4": {
      "aux": {
        "asset": "vgg16_bn",
        "file": "aux.onnx",
        "kind": "imagenet-cls",
        "label": "VGG-16-BN classifier, patched (unused by this camera)"
      }
    }
  },
  "add": "segmenter",
  "words": {
